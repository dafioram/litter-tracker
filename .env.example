# --- FLASK CONFIGURATION ---

# The port you want to access the app on (e.g., http://localhost:5000)
# Default is 5000 if left blank.
PORT=5000

# A secret random string used to secure user sessions (cookies).
# You can generate one by typing `python -c 'import secrets; print(secrets.token_hex(16))'` in your terminal.
SECRET_KEY=change_this_to_a_random_string

# --- DATA CONFIGURATION ---

# Converts CSV timestamps to your local wall-clock time.
#
# First check what your CSV uses: compare its newest row with the newest
# entry in the Whisker app's History screen.
#
# - If the CSV times are UTC (ahead of the app's), set TIMEZONE to your IANA
#   time zone name. This handles daylight saving automatically.
#   Examples: America/New_York, America/Chicago, America/Los_Angeles, Europe/London
# - If the CSV times already match the app (local time), leave TIMEZONE empty
#   and set TIMEZONE_OFFSET=0.
#
# TIMEZONE_OFFSET is the older fixed setting (hours subtracted from CSV times,
# no daylight saving). It is only used when TIMEZONE is empty.
#
# Changing these only affects future imports, not data already imported.
TIMEZONE=America/Los_Angeles
TIMEZONE_OFFSET=8